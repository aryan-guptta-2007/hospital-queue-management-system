PORT=5001
MONGO_URI=mongodb://localhost:27017/hospital_queue
JWT_SECRET=your_super_secret_key_change_this
# Password for the FIRST admin that "npm run seed" creates. No default exists,
# and seeding is refused without it. Changed at first sign-in.
SEED_ADMIN_PASSWORD=
# Optional — defaults to admin@hospital.com
SEED_ADMIN_EMAIL=
JWT_EXPIRES_IN=8h
AVG_CONSULTATION_TIME=10
NODE_ENV=development
# ── Patient SMS notifications ────────────────────────────────────────
# console (default, logs only) | twilio | msg91. A provider missing its
# credentials falls back to console rather than failing the request.
SMS_PROVIDER=console
# How near the front a patient must be to be messaged (once per token)
NOTIFY_AT_POSITION=3
# SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# SMS_PROVIDER=msg91 — the message body lives in a DLT-registered template
# taking the variables: token, position, department
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Login throttle per IP (defaults: 10 attempts / 15 minutes)
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MIN=15
# Token generation throttle per IP. Raise both if patients register from a
# shared kiosk or the hospital sits behind a single public IP.
TOKEN_RATE_LIMIT_MAX=5
TOKEN_RATE_LIMIT_WINDOW_MIN=10
# Comma-separated list of browser origins allowed to call this API
CLIENT_URL=http://localhost:3000
