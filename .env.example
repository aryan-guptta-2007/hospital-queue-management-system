# Settings for docker compose. Copy to .env and fill in before starting:
#   cp .env.example .env

# Required — signs the staff session tokens
JWT_SECRET=
# Required only for the one-off setup profile, which creates the first admin
SEED_ADMIN_PASSWORD=
SEED_ADMIN_EMAIL=admin@hospital.com

# Where the browser reaches the app; the API answers only this origin
CLIENT_URL=http://localhost:8080
WEB_PORT=8080

# Optional tuning
JWT_EXPIRES_IN=8h
AVG_CONSULTATION_TIME=10
SMS_PROVIDER=console
NOTIFY_AT_POSITION=3
TOKEN_RATE_LIMIT_MAX=5
TOKEN_RATE_LIMIT_WINDOW_MIN=10
